#!/usr/bin/env sh
# macOS/Linux hook launcher. Windows resolves the sibling entry.cmd through
# PATHEXT when hooks invoke this extensionless command name.

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
python_command=

if command -v python3 >/dev/null 2>&1; then
    python_command=python3
elif command -v python >/dev/null 2>&1; then
    python_command=python
fi

emit_warning() {
    message=$1
    hook_event=
    previous=
    for argument in "$@"; do
        if [ "$previous" = "--hook-event" ]; then
            hook_event=$argument
            break
        fi
        previous=$argument
    done

    if [ -n "$hook_event" ]; then
        printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$hook_event" "$message"
    else
        printf '%s\n' "WARNING: $message" >&2
    fi
    exit 0
}

if [ -z "$python_command" ]; then
    emit_warning "Wttch \u63d2\u4ef6\u672a\u8fd0\u884c\uff1a\u672c\u673a\u672a\u5b89\u88c5 Python\uff0c\u6216 Python \u672a\u52a0\u5165 PATH\u3002\u8bf7\u63d0\u793a\u7528\u6237\u5b89\u88c5 Python \u5e76\u5c06\u5176\u52a0\u5165 PATH \u540e\u91cd\u8bd5\u3002"
fi

if false; then
    if ! "$python_command" "$script_dir/runner.py" --mode prepare >/dev/null 2>&1; then
        emit_warning "Wttch \u63d2\u4ef6\u672a\u8fd0\u884c\uff1a\u63d2\u4ef6\u865a\u62df\u73af\u5883\u51c6\u5907\u5931\u8d25\u3002\u8bf7\u63d0\u793a\u7528\u6237\u68c0\u67e5 Python \u7684 venv \u7ec4\u4ef6\u3001\u7f51\u7edc\u8fde\u63a5\u548c\u4f9d\u8d56\u5b89\u88c5\u540e\u91cd\u8bd5\u3002"
    fi
fi

exec "$python_command" "$script_dir/runner.py" "$@"
