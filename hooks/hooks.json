{
  "description": "Wttch 私人插件共享的 Hook。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/runtime/bootstrap\" --mode run --hook-event UserPromptSubmit \"${PLUGIN_ROOT}/runtime/model_gate.py\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/runtime/bootstrap.ps1\" --mode run --hook-event UserPromptSubmit \"${PLUGIN_ROOT}/runtime/model_gate.py\"",
            "statusMessage": "检查模型 Gate",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/runtime/bootstrap\" --mode run --hook-event UserPromptSubmit \"${PLUGIN_ROOT}/runtime/jev/main.py\" hook user-prompt-submit",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/runtime/bootstrap.ps1\" --mode run --hook-event UserPromptSubmit \"${PLUGIN_ROOT}/runtime/jev/main.py\" hook user-prompt-submit",
            "statusMessage": "正在 JEV 判决中…",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/runtime/bootstrap\" --mode run --hook-event PreToolUse \"${PLUGIN_ROOT}/runtime/forbidden_server.py\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/runtime/bootstrap.ps1\" --mode run --hook-event PreToolUse \"${PLUGIN_ROOT}/runtime/forbidden_server.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
