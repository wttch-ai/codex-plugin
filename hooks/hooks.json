{
  "description": "Wttch 私人插件共享的 Hook。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runtime/runner.py\" --mode run --hook-event UserPromptSubmit \"${PLUGIN_ROOT}/runtime/model_gate.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runtime/runner.py\" --mode run --hook-event UserPromptSubmit \"${PLUGIN_ROOT}/runtime/jev/main.py\" hook user-prompt-submit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runtime/runner.py\" --mode run --hook-event PreToolUse \"${PLUGIN_ROOT}/runtime/forbidden_server.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runtime/runner.py\" --mode run --hook-event PreToolUse \"${PLUGIN_ROOT}/runtime/jev/main.py\" hook pre-tool-use --policy \"${PLUGIN_ROOT}/skills/jev-gate/hook.yml\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
