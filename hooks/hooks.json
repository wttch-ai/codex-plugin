{
  "description": "Wttch 私人插件共享的 Hook。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync --project ${PLUGIN_ROOT} python ${PLUGIN_ROOT}/runtime/hook_runner.py UserPromptSubmit ${PLUGIN_ROOT}/runtime/model_gate.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-sync --project ${PLUGIN_ROOT} python ${PLUGIN_ROOT}/runtime/hook_runner.py UserPromptSubmit ${PLUGIN_ROOT}/runtime/prompt_jev_gate.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync --project ${PLUGIN_ROOT} python ${PLUGIN_ROOT}/runtime/hook_runner.py PreToolUse ${PLUGIN_ROOT}/runtime/forbidden_server.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync --project ${PLUGIN_ROOT} python ${PLUGIN_ROOT}/runtime/hook_runner.py PreToolUse ${PLUGIN_ROOT}/runtime/jev_gate/main.py jev-gate --policy ${PLUGIN_ROOT}/skills/jev-gate/hook.yml",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
